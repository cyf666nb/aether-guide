# Core runtime
AETHER_ENVIRONMENT=development
AETHER_STORAGE_MODE=inmemory
AETHER_AI_PROVIDER=fake

# Data layer
AETHER_DATABASE_URL=sqlite+aiosqlite:///./.local/aether.db
AETHER_REDIS_URL=redis://localhost:6379/0
AETHER_SEED_DATA_PATH=./infra/seed/scenic_demo.json
AETHER_ADMIN_SEED_PATH=./infra/seed/admins.yaml

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AETHER_JWT_SECRET=dev-only-secret-change-me-in-production
AETHER_JWT_ALGORITHM=HS256
AETHER_TOURIST_TOKEN_TTL_MINUTES=1440
AETHER_ADMIN_TOKEN_TTL_MINUTES=480

# CORS: comma-separated origins. In production, "*" is forbidden.
AETHER_CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# Rate limiting
AETHER_RATE_LIMIT_PER_MINUTE=120

# LLM governance
AETHER_LLM_TIMEOUT_SECONDS=6
AETHER_LLM_MAX_RETRIES=2

# Optional: LiteLLM provider keys (only when AETHER_AI_PROVIDER=litellm)
# LITELLM_API_KEY=
# OPENAI_API_KEY=
